---
interface Props { caption?: string; height?: number; }
const { caption, height = 430 } = Astro.props;
---
<figure class="viz depthmountain" data-caption={caption} data-height={height} data-height-mobile="540" tabindex="0">
  <div class="viz-cell"></div>
</figure>
<script>
// The block is weight-tied, so the trained operator can be applied any number
// of times. Run it at every depth from 0 to 12 on the full test set and the
// result is a mountain with its peak exactly at the trained depth: this
// recursion is a program tuned to stop at four, not a flow that settles.
import { defineViz } from './engine/vizkit.js';
import { T, fmt, gate, loadingText } from './engine/draw.js';
import { load } from './patchconv.js';

defineViz('depthmountain', {
  title: 'Trained at four, run at every depth',
  height: 430,
  controls: [
    { type: 'range', name: 'r', label: 'depth at inference', min: 0, max: 12, step: 1, value: 4, int: true, play: { period: 12000, loop: false } },
    { type: 'readout', name: 'rd' },
  ],
  setup(api) {
    gate(api, () => load('story'), (a, d) => { a.state.d = d; });
  },
  draw(api) {
    const { ctx, colors, size: { W, H } } = api, st = api.state;
    if (!st.ready) { loadingText(api, 'loading the transfer curves…'); return; }
    const d = st.d, r = Math.round(api.get('r'));
    const pad = 14, top = 32;
    const box = { x: pad + 34, y: top, w: W - pad * 2 - 44, h: H - top - 96 };
    const lx = (rr) => box.x + (rr / 12) * box.w;
    const ly = (a) => box.y + box.h - (a / 24) * box.h;
    ctx.fillStyle = colors.cellBg;
    ctx.fillRect(box.x, box.y, box.w, box.h);
    ctx.strokeStyle = colors.border;
    ctx.strokeRect(box.x + 0.5, box.y + 0.5, box.w - 1, box.h - 1);
    T(ctx, colors, 'small');
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const a of [5, 10, 15, 20]) ctx.fillText(a + '%', box.x - 3, ly(a));
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (let rr = 0; rr <= 12; rr += 2) ctx.fillText(String(rr), lx(rr), box.y + box.h + 5);
    ctx.fillText('rounds applied at inference', lx(6), box.y + box.h + 22);
    // chance + the flat whole-image baseline
    ctx.setLineDash([3, 4]); ctx.strokeStyle = colors.faint;
    ctx.beginPath(); ctx.moveTo(box.x, ly(1)); ctx.lineTo(box.x + box.w, ly(1)); ctx.stroke();
    ctx.strokeStyle = '#c2553a';
    ctx.beginPath(); ctx.moveTo(box.x, ly(d.flat.fine)); ctx.lineTo(box.x + box.w, ly(d.flat.fine)); ctx.stroke();
    ctx.setLineDash([]);
    T(ctx, colors, 'small');
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = '#c2553a';
    ctx.fillText(`flat whole-image model, ${fmt(d.flat.fine, 1)}%`, box.x + 6, ly(d.flat.fine) - 5);
    // trained-depth marker
    ctx.strokeStyle = colors.faint; ctx.setLineDash([2, 3]);
    ctx.beginPath(); ctx.moveTo(lx(4), box.y); ctx.lineTo(lx(4), box.y + box.h); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = colors.faint;
    ctx.fillText('trained here', lx(4) + 5, box.y + 14);
    // the three seeds' mountains
    for (const rowT of d.transfer) {
      ctx.strokeStyle = '#4a7fb3'; ctx.globalAlpha = 0.7; ctx.lineWidth = 1.8;
      ctx.beginPath();
      rowT.forEach((v, rr) => { rr === 0 ? ctx.moveTo(lx(rr), ly(v[0])) : ctx.lineTo(lx(rr), ly(v[0])); });
      ctx.stroke(); ctx.globalAlpha = 1; ctx.lineWidth = 1;
    }
    // current-depth marker dots
    for (const rowT of d.transfer) {
      ctx.fillStyle = '#4a7fb3';
      ctx.beginPath(); ctx.arc(lx(r), ly(rowT[r][0]), 3.5, 0, 6.29); ctx.fill();
    }
    T(ctx, colors, 'label');
    ctx.fillText('100-way accuracy of the SAME weights, applied r times (three seeds)', box.x, top - 8);
    const t0 = d.transfer[0][r];
    api.readout('rd', `r = ${r}: fine ${fmt(t0[0], 1)}% = coarse ${fmt(t0[1], 1)}% x sibling ${fmt(t0[2], 1)}% (seed 0)` +
      (r === 4 ? '  <- the trained depth' : ''));
  },
});
</script>
