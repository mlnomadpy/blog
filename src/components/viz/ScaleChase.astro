---
interface Props { caption?: string; height?: number; }
const { caption, height = 440 } = Astro.props;
---
<figure class="viz scalechase" data-caption={caption} data-height={height} data-height-mobile="540" tabindex="0">
  <div class="viz-cell"></div>
</figure>
<script>
// Why the softening never engages, at any granularity. As the patches shrink,
// the distances between a patch and a prototype collapse by two orders of
// magnitude. Training simply follows them down: epsilon shrinks too, and the
// gap between the two never closes. The softening is not idle by accident of
// scale, it is kept idle.
import { defineViz } from './engine/vizkit.js';
import { T, fmt, gate, loadingText, legend } from './engine/draw.js';
import { load } from './patchparts.js';

defineViz('scalechase', {
  title: 'ε chases the distances down and never catches them',
  height: 440,
  controls: [{ type: 'readout', name: 'rd' }],
  setup(api) { gate(api, () => load('sizes'), (a, d) => { a.state.s = d.sizes; }); },
  draw(api) {
    const { ctx, colors, size: { W, H } } = api, st = api.state;
    if (!st.ready) { loadingText(api, 'loading the scales…'); return; }
    const S = st.s, pad = 14, top = 34;
    const box = { x: pad + 44, y: top, w: W - 2 * pad - 54, h: H - top - 84 };
    const lo = -3.2, hi = 3.0;                       // log10 range
    const ly = (v) => box.y + box.h - ((Math.log10(Math.max(v, 1e-4)) - lo) / (hi - lo)) * box.h;
    const lx = (i) => box.x + ((i + 0.5) / S.length) * box.w;
    ctx.strokeStyle = colors.border;
    ctx.strokeRect(box.x + 0.5, box.y + 0.5, box.w - 1, box.h - 1);
    T(ctx, colors, 'small');
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const p of [-3, -2, -1, 0, 1, 2]) ctx.fillText('1e' + p, box.x - 4, ly(Math.pow(10, p)));
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    S.forEach((s, i) => ctx.fillText(`${s.P}px`, lx(i), box.y + box.h + 5));
    const series = [
      { k: 'median_d2', color: '#4a7fb3', label: 'median distance² between a patch and a prototype' },
      { k: 'min_d2', color: '#3a8f5e', label: 'the closest approach anywhere in the test set' },
      { k: 'eps', color: '#c2553a', label: 'the learned softening ε' },
    ];
    for (const se of series) {
      ctx.strokeStyle = se.color; ctx.lineWidth = 2.2;
      ctx.beginPath();
      S.forEach((s, i) => { const x = lx(i), y = ly(s[se.k]); i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y); });
      ctx.stroke(); ctx.lineWidth = 1;
      S.forEach((s, i) => { ctx.fillStyle = se.color; ctx.beginPath(); ctx.arc(lx(i), ly(s[se.k]), 3.4, 0, 6.283); ctx.fill(); });
    }
    // the gap that never closes
    S.forEach((s, i) => {
      ctx.strokeStyle = colors.faint; ctx.setLineDash([2, 3]);
      ctx.beginPath(); ctx.moveTo(lx(i), ly(s.eps)); ctx.lineTo(lx(i), ly(s.median_d2)); ctx.stroke();
      ctx.setLineDash([]);
      T(ctx, colors, 'small'); ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText(`${fmt(s.median_d2 / s.eps, 0)}×`, lx(i), ly(Math.sqrt(s.eps * s.median_d2)));
    });
    legend(ctx, box.x + 10, box.y + 14, series.map((s) => ({ color: s.color, label: s.label })), colors);
    T(ctx, colors, 'label'); ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    ctx.fillText('all three quantities on one log axis, as the patches shrink', box.x, box.y - 8);
    T(ctx, colors, 'small');
    ctx.fillText('the numbers on the dashed lines are how many times larger the typical distance is than the softening: the gap barely narrows', pad, H - 28);
    ctx.fillText('the green line is the one that matters at four pixels: the nearest patches finally reach ε, even though the typical ones never do', pad, H - 13);
    const last = S[S.length - 1];
    api.readout('rd', `at ${last.P}px: distances fell ${fmt(S[0].median_d2 / last.median_d2, 0)}× and ε fell ${fmt(S[0].eps / last.eps, 0)}×, so the ratio moved only ${fmt(last.eps_ratio / S[0].eps_ratio, 1)}×`);
  },
});
</script>
