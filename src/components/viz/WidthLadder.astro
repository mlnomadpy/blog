---
interface Props {
  caption?: string;
  height?: number;
}
const { caption, height = 470 } = Astro.props;
---
<figure class="viz widthladder" data-caption={caption} data-height={height} data-height-mobile="560" tabindex="0">
  <div class="viz-cell"></div>
</figure>

<script>
// The width ladder from the run: accuracy against the number of frozen units,
// every arm at its own bracketed learning rate, three seeds. The series'
// earlier rungs (raw-pixel solve, hand-built features, trained backbone) are
// drawn as horizontal rungs so the frozen banks can be watched climbing past
// them.
import { defineViz } from './engine/vizkit.js';
import { T, fmt, axes, gate, loadingText, legend } from './engine/draw.js';
import { load } from './lazytrain.js';

const SHOW = [
  { id: 'yat_frozen', label: 'yat, frozen random bank', color: '#4a7fb3' },
  { id: 'yat_data', label: 'yat, frozen data-seeded bank', color: '#3a8f5e' },
  { id: 'relu_frozen', label: 'relu, frozen random bank', color: '#9a4f9c' },
  { id: 'yat_trained', label: 'yat, everything trains', color: '#c2553a' },
];
const RUNGS = [
  { v: 79.0, label: 'raw-pixel constructed head 79' },
  { v: 83.3, label: 'hand-built features 83.3' },
  { v: 85.7, label: 'trained backbone head 85.7' },
];

defineViz('widthladder', {
  title: 'What m frozen neurons buy, against the rungs this series built',
  height: 470,
  controls: [{ type: 'readout', name: 'rd' }],

  setup(api) {
    const st = api.state;
    st.hover = -1;
    gate(api, () => load('curves'), (a, data) => { a.state.data = data; });
    api.canvas.addEventListener('pointermove', (e) => {
      const r = api.canvas.getBoundingClientRect();
      st.mx = e.clientX - r.left;
      api.render();
    });
  },

  draw(api) {
    const { ctx, colors, size: { W, H } } = api, st = api.state;
    if (!st.ready) { loadingText(api, 'loading the run…'); return; }
    const d = st.data, widths = d.widths;
    const pad = 14, top = 26;
    const box = { x: pad + 34, y: top, w: W - pad - 44 - 34, h: H - top - 92 };
    const lx = (m) => box.x + (Math.log(m / widths[0]) / Math.log(widths[widths.length - 1] / widths[0])) * box.w;
    const vy = (a) => box.y + box.h - ((a - 55) / (92 - 55)) * box.h;
    ctx.strokeStyle = colors.border;
    ctx.strokeRect(box.x + 0.5, box.y + 0.5, box.w - 1, box.h - 1);
    T(ctx, colors, 'small');
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const m of widths) if ([16, 64, 256, 1024, 4096].includes(m) || m === widths[widths.length - 1]) ctx.fillText(String(m), lx(m), box.y + box.h + 4);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const a of [60, 70, 80, 90]) ctx.fillText(a + '%', box.x - 4, vy(a));

    // the series' rungs
    for (const r of RUNGS) {
      ctx.strokeStyle = colors.faint; ctx.setLineDash([3, 4]);
      ctx.beginPath(); ctx.moveTo(box.x, vy(r.v)); ctx.lineTo(box.x + box.w, vy(r.v)); ctx.stroke();
      ctx.setLineDash([]);
      T(ctx, colors, 'small');
      ctx.textAlign = 'right'; ctx.textBaseline = 'bottom';
      ctx.fillText(r.label, box.x + box.w - 4, vy(r.v) - 1);
    }

    // hover: nearest width column
    let hi = -1;
    if (st.mx != null && st.mx > box.x && st.mx < box.x + box.w) {
      let bd = 1e9;
      widths.forEach((m, i) => { const dd = Math.abs(lx(m) - st.mx); if (dd < bd) { bd = dd; hi = i; } });
      ctx.strokeStyle = colors.faint; ctx.setLineDash([2, 3]);
      ctx.beginPath(); ctx.moveTo(lx(widths[hi]), box.y); ctx.lineTo(lx(widths[hi]), box.y + box.h); ctx.stroke();
      ctx.setLineDash([]);
    }

    for (const s of SHOW) {
      const arm = d.arms[s.id];
      if (!arm) continue;
      // seed band
      ctx.globalAlpha = 0.13; ctx.fillStyle = s.color;
      ctx.beginPath();
      widths.forEach((m, i) => { if (arm.mean[i] != null) ctx.lineTo(lx(m), vy(arm.mean[i] + arm.std[i])); });
      [...widths].reverse().forEach((m) => { const i = widths.indexOf(m); if (arm.mean[i] != null) ctx.lineTo(lx(m), vy(arm.mean[i] - arm.std[i])); });
      ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;
      ctx.strokeStyle = s.color; ctx.lineWidth = s.id === 'yat_trained' ? 2.4 : 1.8;
      if (s.id === 'yat_trained') ctx.setLineDash([6, 3]);
      ctx.beginPath();
      widths.forEach((m, i) => { if (arm.mean[i] != null) { const x = lx(m), y = vy(arm.mean[i]); i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y); } });
      ctx.stroke(); ctx.setLineDash([]); ctx.lineWidth = 1;
      widths.forEach((m, i) => {
        if (arm.mean[i] == null) return;
        ctx.fillStyle = s.color;
        ctx.beginPath(); ctx.arc(lx(m), vy(arm.mean[i]), hi === i ? 3.4 : 2.2, 0, 2 * Math.PI); ctx.fill();
      });
    }
    legend(ctx, box.x + 10, box.y + 16, SHOW.map((s) => ({ color: s.color, label: s.label })), colors);
    T(ctx, colors, 'small');
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    ctx.fillText('x: number of hidden units m (log); y: held-out accuracy, mean of 3 seeds, band = seed spread; each arm at its own bracketed rate', pad, H - 44);
    ctx.fillText('the dashed red line never comes down to meet the others: no frozen bank in the sweep reaches sixteen trained neurons', pad, H - 28);
    if (hi >= 0) {
      const parts = SHOW.map((s) => {
        const v = d.arms[s.id]?.mean[hi];
        return v == null ? null : `${s.label.split(',')[0]} ${fmt(v, 1)}`;
      }).filter(Boolean);
      api.readout('rd', `m = ${widths[hi]}: ${parts.join(', ')}`);
    } else {
      api.readout('rd', 'hover for exact values');
    }
  },
});
</script>
