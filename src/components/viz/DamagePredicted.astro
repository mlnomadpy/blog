---
interface Props {
  caption?: string;
  height?: number;
}
const { caption, height = 440 } = Astro.props;
---
<figure class="viz damagepredicted" data-caption={caption} data-height={height} data-height-mobile="540" tabindex="0">
  <div class="viz-cell"></div>
</figure>

<script>
// Predicted against measured. Before any cut, the class-mode map plus the
// readout's coefficients predict which class pairs a mode is holding
// together. Then the mode is cut and the damage measured. The cloud is the
// honest verdict on how far the map goes.
import { defineViz } from './engine/vizkit.js';
import { T, fmt, gate, loadingText } from './engine/draw.js';
import { load } from './surgery.js';

defineViz('damagepredicted', {
  title: 'What the map predicted, what the cut did',
  height: 440,
  controls: [
    { type: 'select', name: 'mode', label: 'mode', reset: false, value: 'all', options: [{ value: 'all', label: 'all eight' }, ...[0, 1, 2, 3, 4, 5, 6, 7].map((k) => ({ value: String(k), label: `mode ${k + 1}` }))] },
    { type: 'readout', name: 'rd' },
  ],

  setup(api) {
    const st = api.state;
    st.hover = null;
    gate(api, () => load('predict'), (a, data) => { a.state.data = data; });
    api.canvas.addEventListener('pointermove', (e) => {
      if (!st.ready || !st.pts) return;
      const r = api.canvas.getBoundingClientRect();
      const p = { x: e.clientX - r.left, y: e.clientY - r.top };
      let best = 12, hit = null;
      for (const q of st.pts) {
        const dd = Math.hypot(q.x - p.x, q.y - p.y);
        if (dd < best) { best = dd; hit = q; }
      }
      st.hover = hit;
      api.render();
    });
  },

  draw(api) {
    const { ctx, colors, size: { W, H } } = api, st = api.state;
    if (!st.ready) { loadingText(api, 'loading the cuts…'); return; }
    const d = st.data;
    const sel = api.get('mode');
    const rows = d.scatter.filter((r) => sel === 'all' || r[0] === +sel);
    const pad = 14, top = 30;
    const box = { x: pad + 38, y: top, w: W - 2 * pad - 48, h: H - top - 78 };
    const maxP = Math.max(...rows.map((r) => r[3])) || 1;
    const maxD = Math.max(20, ...rows.map((r) => r[4]));
    const minD = Math.min(-10, ...rows.map((r) => r[4]));
    const sx = (v) => box.x + (v / maxP) * box.w;
    const sy = (v) => box.y + box.h - ((v - minD) / (maxD - minD)) * box.h;
    ctx.strokeStyle = colors.border;
    ctx.strokeRect(box.x + 0.5, box.y + 0.5, box.w - 1, box.h - 1);
    // zero line
    ctx.strokeStyle = colors.faint; ctx.setLineDash([3, 4]);
    ctx.beginPath(); ctx.moveTo(box.x, sy(0)); ctx.lineTo(box.x + box.w, sy(0)); ctx.stroke();
    ctx.setLineDash([]);
    T(ctx, colors, 'small');
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const v of [0, Math.round(maxD / 2), Math.round(maxD)]) ctx.fillText(String(v), box.x - 3, sy(v));
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('predicted risk for this pair, before the cut', box.x + box.w / 2, box.y + box.h + 16);
    st.pts = [];
    const PAL = ['#b3661b', '#4a7fb3', '#3a8f5e', '#9a4f9c', '#c2553a', '#5a5f66', '#7a5cc4', '#2f8f8f'];
    for (const r of rows) {
      const x = sx(r[3]), yv = sy(r[4]);
      ctx.fillStyle = PAL[r[0] % PAL.length];
      ctx.globalAlpha = 0.75;
      ctx.beginPath(); ctx.arc(x, yv, 3.2, 0, 6.283); ctx.fill();
      ctx.globalAlpha = 1;
      st.pts.push({ x, y: yv, r });
    }
    if (st.hover) {
      const { x, y, r } = st.hover;
      ctx.strokeStyle = colors.fg; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.arc(x, y, 6, 0, 6.283); ctx.stroke();
      ctx.lineWidth = 1;
    }
    T(ctx, colors, 'label');
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    ctx.fillText('new errors the cut created for this class pair', box.x, box.y - 8);
    T(ctx, colors, 'small');
    ctx.fillText('one dot per class pair per cut mode; colour is the mode; hover a dot to name the pair', pad, H - 38);
    ctx.fillText('the map points in the right direction and no further: high-risk pairs do break, but plenty of damage lands where nothing was predicted', pad, H - 20);
    const rr = sel === 'all' ? d.r : null;
    api.readout('rd', st.hover
      ? `${d.classes[st.hover.r[1]]} vs ${d.classes[st.hover.r[2]]} under mode ${st.hover.r[0] + 1}: predicted ${fmt(st.hover.r[3], 2)}, measured ${st.hover.r[4]} new errors`
      : (rr !== null ? `correlation across all 360 pair-cuts: r = ${fmt(rr, 2)} (rank r = ${fmt(d.rank_r, 2)})` : 'hover a dot to name the pair'));
  },
});
</script>
