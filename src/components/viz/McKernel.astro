---
interface Props {
  caption?: string;
  height?: number;
}
const { caption, height = 440 } = Astro.props;
---
<figure class="viz mckernel" data-caption={caption} data-height={height} data-height-mobile="560" tabindex="0">
  <div class="viz-cell"></div>
</figure>

<script>
// One neuron, one sample. The random-feature kernel between two real images
// is an expectation over random prototypes; a bank of m frozen units is an
// m-sample Monte Carlo estimate of it. Add neurons one at a time and watch
// the running average converge at the 1/sqrt(m) rate, for a same-class pair
// and a different-class pair at once.
import { defineViz } from './engine/vizkit.js';
import { T, fmt, axes, gate, loadingText, legend } from './engine/draw.js';
import { load, randomBank, yatRow, bankNorms, drawGlyph } from './lazytrain.js';

const D = 196, MMAX = 4096;

defineViz('mckernel', {
  title: 'Every frozen neuron is one Monte Carlo sample of a kernel',
  height: 440,
  stepsPerFrame: 3,
  maxStep: MMAX,
  controls: [
    { type: 'play' },
    { type: 'reset', label: 'Reroll the bank' },
    { type: 'readout', name: 'rd' },
  ],

  setup(api) {
    const st = api.state;
    st.m = 0;
    st.seedBase = ((Math.random() * 1e6) | 0);
    gate(api, () => load('fmnist14'), (a, data) => {
      const s = a.state;
      s.data = data;
      // a same-class pair and a different-class pair, fixed real images
      const y = data.ytr;
      const firstOf = (c, skip = -1) => y.findIndex((v, i) => v === c && i !== skip);
      const a1 = firstOf(0), a2 = firstOf(0, a1), b1 = firstOf(1);
      s.pairs = [
        { i: a1, j: a2, label: 'same class (two T-shirts)', color: '#4a7fb3', hist: [], sum: 0, sq: 0 },
        { i: a1, j: b1, label: 'different class (T-shirt vs Trouser)', color: '#c2553a', hist: [], sum: 0, sq: 0 },
      ];
      const toF = (img) => Float32Array.from(img, (v) => v / 255);
      s.imgs = {};
      for (const p of s.pairs) { s.imgs[p.i] = toF(data.Xtr[p.i]); s.imgs[p.j] = toF(data.Xtr[p.j]); }
      // the reference: a big-bank estimate of each kernel value
      const Wref = randomBank(MMAX, D, 999);
      const wnRef = bankNorms(Wref, MMAX, D);
      const buf = new Float32Array(MMAX), buf2 = new Float32Array(MMAX);
      for (const p of s.pairs) {
        const fi = yatRow(s.imgs[p.i], Wref, MMAX, D, buf, wnRef);
        const fj = yatRow(s.imgs[p.j], Wref, MMAX, D, buf2, wnRef);
        let acc = 0;
        for (let u = 0; u < MMAX; u++) acc += fi[u] * fj[u];
        p.ref = acc / MMAX;
      }
    });
  },

  step(api) {
    const st = api.state;
    if (!st.pairs || st.m >= MMAX) return;
    // one more neuron: one fresh random prototype, one more sample
    const w = randomBank(1, D, st.seedBase + st.m * 7 + 1);
    st.m++;
    for (const p of st.pairs) {
      const fi = yatRow(st.imgs[p.i], w, 1, D)[0];
      const fj = yatRow(st.imgs[p.j], w, 1, D)[0];
      const s = fi * fj;
      p.sum += s; p.sq += s * s;
      p.hist.push(p.sum / st.m);
    }
  },

  draw(api) {
    const { ctx, colors, size: { W, H } } = api, st = api.state;
    if (!st.ready) { loadingText(api, 'loading the images…'); return; }
    const pad = 14, top = 30;

    // the two image pairs on the left
    const gw = 44;
    st.pairs.forEach((p, pi) => {
      const y0 = top + pi * (gw + 44);
      drawGlyph(ctx, st.data.Xtr[p.i], 14, pad, y0, gw, gw, true, 'mk' + p.i);
      drawGlyph(ctx, st.data.Xtr[p.j], 14, pad + gw + 8, y0, gw, gw, true, 'mk' + p.j);
      ctx.strokeStyle = p.color; ctx.lineWidth = 2;
      ctx.strokeRect(pad + 0.5, y0 + 0.5, gw - 1, gw - 1);
      ctx.strokeRect(pad + gw + 8.5, y0 + 0.5, gw - 1, gw - 1);
      ctx.lineWidth = 1;
      T(ctx, colors, 'small');
      ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      ctx.fillText(p.label, pad, y0 + gw + 14);
    });

    // the running averages, log-x
    const cbox = { x: pad + 2 * gw + 60, y: top, w: W - (pad + 2 * gw + 60) - pad - 6, h: H - top - 74 };
    const lx = (m) => cbox.x + (Math.log(Math.max(1, m)) / Math.log(MMAX)) * cbox.w;
    let vmax = 0;
    for (const p of st.pairs) vmax = Math.max(vmax, p.ref * 2.2, ...(p.hist.length ? [p.hist[Math.min(4, p.hist.length - 1)]] : [0]));
    vmax = Math.max(vmax, 1e-6);
    const vy = (v) => cbox.y + cbox.h - Math.max(0, Math.min(1, v / vmax)) * cbox.h;
    ctx.strokeStyle = colors.border;
    ctx.strokeRect(cbox.x + 0.5, cbox.y + 0.5, cbox.w - 1, cbox.h - 1);
    T(ctx, colors, 'small');
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const m of [1, 10, 100, 1000, MMAX]) ctx.fillText(String(m), lx(m), cbox.y + cbox.h + 4);
    ctx.textAlign = 'left';
    ctx.fillText('neurons in the bank (log scale)', cbox.x, cbox.y + cbox.h + 20);
    for (const p of st.pairs) {
      // the reference line and the 1/sqrt(m) envelope around it
      ctx.strokeStyle = p.color; ctx.setLineDash([4, 4]); ctx.globalAlpha = 0.55;
      ctx.beginPath(); ctx.moveTo(cbox.x, vy(p.ref)); ctx.lineTo(cbox.x + cbox.w, vy(p.ref)); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      if (st.m > 2) {
        const sd = Math.sqrt(Math.max(0, p.sq / st.m - (p.sum / st.m) ** 2));
        ctx.globalAlpha = 0.14; ctx.fillStyle = p.color;
        ctx.beginPath();
        for (let m = 2; m <= st.m; m += Math.max(1, (st.m / 160) | 0)) ctx.lineTo(lx(m), vy(p.ref + sd / Math.sqrt(m)));
        for (let m = st.m; m >= 2; m -= Math.max(1, (st.m / 160) | 0)) ctx.lineTo(lx(m), vy(Math.max(0, p.ref - sd / Math.sqrt(m))));
        ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;
      }
      ctx.strokeStyle = p.color; ctx.lineWidth = 1.8;
      ctx.beginPath();
      p.hist.forEach((v, i) => {
        const x = lx(i + 1), y = vy(v);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.lineWidth = 1;
    }
    legend(ctx, cbox.x + 8, cbox.y + 14, st.pairs.map((p) => ({ color: p.color, label: p.label })), colors);
    T(ctx, colors, 'small');
    ctx.fillText('solid: the running average (1/m) sum of phi(x) phi(y); dashed: the 4096-unit estimate; band: +-sd/sqrt(m)', cbox.x, cbox.y - 8);
    ctx.fillText('the shaded funnel IS the Monte Carlo rate: to halve the noise, quadruple the neurons', pad, H - 14);
    api.readout('rd', st.m ? `m = ${st.m}: same-class avg ${fmt(st.pairs[0].hist[st.m - 1], 3)}, different-class ${fmt(st.pairs[1].hist[st.m - 1], 3)}` : 'press play to add neurons');
  },
});
</script>
